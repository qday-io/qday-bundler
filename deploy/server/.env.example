# Copy to .env and `chmod 600 .env`. ⛔ Never commit .env — it holds the bundler key.

# Dedicated bundler EOA. It pays QDAY for every handleOps; keep it funded.
SIGNER_PRIVATE_KEYS=

# Image tag: `testnet` follows qday/v0.11.0; pin a commit SHA or qday-v* tag for stability.
BUNDLER_TAG=testnet

# Optional overrides
# NODE_HTTP=http://cdk-erigon-rpc:8545
# MIN_STAKE_VALUE=100000000000000000
# RUST_LOG=info
